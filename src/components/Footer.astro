---
import ProfileLink from './ProfileLink.astro';
import { EMAIL } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer container">
  <div class="footer-identity"><span>Wangdong Jia</span><span class="copyright">© {year}</span></div>
  {EMAIL && <div class="footer-links" aria-label="Contact">
    <ProfileLink label="Email" href={`mailto:${EMAIL}`} />
  </div>}
</footer>
